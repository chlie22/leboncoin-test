              "host": ["{{baseUrl}}"],
              "path": ["v1", "fizzbuzz"],
              "query": [
                { "key": "int1", "value": "3" },
                { "key": "int2", "value": "5" },
                { "key": "limit", "value": "15" },
                { "key": "str1", "value": "fizz" },
                { "key": "str2", "value": "buzz" }
              ]
            },
            "description": "Suite attendue : 1, 2, fizz, 4, buzz, … fizzbuzz. L'appel est comptabilisé dans les stats."
